rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    // 사용자가 인증되었는지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 요청자가 해당 데이터의 소유자인지 확인
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 관리자 여부 확인 (특정 이메일 또는 역할 기반)
    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "yant3722@gmail.com" && request.auth.token.email_verified == true));
    }

    // 사용자 프로필 데이터 유효성 검사
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string &&
             (data.displayName == null || data.displayName is string);
    }

    // 음주 기록 데이터 유효성 검사
    function isValidUserLog(data) {
      return data.userId == request.auth.uid &&
             data.drinkCategory is string &&
             data.consumedAt is string &&
             data.drinkName is string &&
             data.drinkName.size() > 0 && data.drinkName.size() < 100;
    }

    // 목표 데이터 유효성 검사
    function isValidUserGoal(data) {
      return data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 && data.title.size() < 100 &&
             data.goalType is string &&
             data.period is string &&
             data.targetValue is number &&
             data.unit is string &&
             data.enabled is bool;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 사용자 프로필: 본인만 읽고 쓸 수 있음
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    // 음주 기록 서브 컬렉션: 본인만 접근 가능
    match /users/{userId}/logs/{logId} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);

      // 쓰기 시 데이터 유효성 추가 검증
      allow create, update: if isOwner(userId) && isValidUserLog(request.resource.data);
    }

    // 목표 설정 서브 컬렉션: 본인만 접근 가능
    match /users/{userId}/goals/{goalId} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);

      // 쓰기 시 데이터 유효성 추가 검증
      allow create, update: if isOwner(userId) && isValidUserGoal(request.resource.data);
    }

    // 기타 모든 경로는 기본적으로 거부
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
